{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "GITHUB_PAGES=true npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "https://dpleshakov.ru/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://dpleshakov.ru/:path*",
      "permanent": true
    }
  ]
}
